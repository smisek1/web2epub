# Copy to .env and adjust. .env is gitignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=conversion

# How the Node API and Python worker reach the database.
# Inside the compose network the host is the service name "postgres".
DB_HOST=postgres
DB_PORT=5432

# --- Ports exposed on the host ---
POSTGRES_HOST_PORT=5432
API_PORT=3000
FRONTEND_PORT=8080
